{
  "name": "@wity/graph-headless",
  "version": "0.2.17",
  "description": "Headless, ontologically-grounded directed graph library. Pure state, layout, traversal, and geometry — zero DOM dependencies.",
  "type": "module",
  "main": "./dist/graph-headless.cjs",
  "module": "./dist/graph-headless.esm.js",
  "exports": {
    ".": {
      "import": "./dist/graph-headless.esm.js",
      "require": "./dist/graph-headless.cjs",
      "default": "./dist/graph-headless.esm.js"
    }
  },
  "scripts": {
    "build": "rollup -c"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.0.0"
  },
  "keywords": ["graph", "headless", "directed-graph", "layout", "ontology"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
